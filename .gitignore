# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
.eggs/

# Unit test / coverage reports
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Type checkers / linters
.mypy_cache/
.ruff_cache/
.pyre/

# Environments
.env
.env.*
!.env.example
.venv
env/
venv/
ENV/

# Secrets - never commit credentials, keys or certificates
*.secret
secrets.*
credentials.*
*.pem
*.key
id_rsa
id_ed25519

# IDE
.idea/
.vscode/
*.sublime-workspace

# Jupyter / IPython
.ipynb_checkpoints
profile_default/
ipython_config.py

# OS
.DS_Store
Thumbs.db
*.stackdump

# ArcGIS Pro - locally regenerated artefacts
*.aprx
scratch.gdb/
*.sr.lock

# ArcGIS Pro - test output
# Integration tests write to a temporary geodatabase; this folder is the
# legacy location and is never part of the repository.
data/_testdata/results_test.gdb/
